{
  "name": "@caloria/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Código compartido por front-service y back-service: catálogo de errores, AppError, requestId, logger y middleware de errores",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zod": "^4.1.0"
  }
}
