# Copiar a infra/.env (está en .gitignore) y completar.

# HTTPS (ver README, "HTTPS"). Dominio que atiende nginx: localhost en local; en el servidor, el
# que apunta a su IP (ej.: api.caloria.app).
DOMAIN=localhost
# En el servidor: COMPOSE_PROFILES=letsencrypt (certbot pide y renueva el certificado).
# Sin dominio, para la demo: COMPOSE_PROFILES=tunnel (quick tunnel de Cloudflare). En local, vacío.
COMPOSE_PROFILES=
# Email de la cuenta de Let's Encrypt. Obligatorio con el perfil letsencrypt.
LETSENCRYPT_EMAIL=
# 1 (default): entorno de staging, para probar sin gastar los límites de producción; el
# certificado no es válido para ningún cliente. 0: el certificado real.
LETSENCRYPT_STAGING=1
# Segundos de HSTS. Arrancar corto (300) y subirlo de a poco cuando HTTPS ande bien (ver README).
HSTS_MAX_AGE=300

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# MinIO: root solo para minio y minio-init; el usuario de servicio es el que usan Back y Worker.
# Usuarios: ≥ 3 caracteres. Password root: ≥ 8. Secret del usuario de servicio: entre 8 y 40
# (ej.: openssl rand -hex 16).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Solo la recibe el Worker. Obligatoria: sin clave el Worker no arranca.
OPENAI_API_KEY=
# Opcional: modelo de visión del análisis (por defecto gpt-6-luna).
OPENAI_VISION_MODEL=
# Opcional: modelo de transcripción del audio (por defecto gpt-transcribe).
OPENAI_TRANSCRIPTION_MODEL=
# Opcional: modelo de texto de los insights del Wrapped (por defecto gpt-6.1-terra).
OPENAI_TEXT_MODEL=
# Opcional: modelo del comentario por tono (por defecto gpt-6-luna). Tiene que aceptar
# structured outputs y reasoning "low".
OPENAI_COMMENT_MODEL=
# Opcional, solo Worker: token de acceso de Expo, si el proyecto tiene activada la seguridad de push.
EXPO_ACCESS_TOKEN=
# Opcional: jobs de análisis que el Worker procesa en paralelo (entero positivo, por defecto 2).
WORKER_CONCURRENCY=
# Host con el que se firman las URLs: el que alcanza la app (dev: http://localhost:9000).
S3_PUBLIC_ENDPOINT=http://localhost:9000

FREE_MONTHLY_ANALYSES=40
# Opcionales: fotos por día y por usuario (RNF-07). Por defecto 20 en free y 100 en premium.
DAILY_ANALYSES_FREE=
DAILY_ANALYSES_PREMIUM=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=