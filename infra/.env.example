# Copiar a infra/.env (está en .gitignore) y completar.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# MinIO: root solo para minio y minio-init; el usuario de servicio es el que usan Back y Worker.
# Usuarios: ≥ 3 caracteres. Password root: ≥ 8. Secret del usuario de servicio: entre 8 y 40
# (ej.: openssl rand -hex 16).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Host con el que se firman las URLs: el que alcanza la app (dev: http://localhost:9000).
S3_PUBLIC_ENDPOINT=http://localhost:9000
