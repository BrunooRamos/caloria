{
  "expo": {
    "name": "app",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "caloria",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "CalorIA usa la cámara para sacarle una foto a tu comida y estimar sus calorías y macros.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CalorIA usa tus fotos para que elijas la de tu comida y estime sus calorías y macros.",
          "cameraPermission": "CalorIA usa la cámara para sacarle una foto a tu comida y estimar sus calorías y macros.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
