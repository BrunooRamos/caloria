{
  "expo": {
    "name": "CalorIA",
    "slug": "caloria",
    "owner": "bramos5",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "caloria",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {}
    },
    "android": {
      "package": "app.caloria",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EC"
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "CalorIA usa la cámara para sacarle una foto a tu comida y estimar sus calorías y macros.",
          "microphonePermission": "CalorIA usa el micrófono para que cuentes cómo preparaste tu comida y así estime mejor sus calorías y macros.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CalorIA usa tus fotos para que elijas la de tu comida y estime sus calorías y macros.",
          "cameraPermission": "CalorIA usa la cámara para sacarle una foto a tu comida y estimar sus calorías y macros.",
          "microphonePermission": "CalorIA usa el micrófono para que cuentes cómo preparaste tu comida y así estime mejor sus calorías y macros."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CalorIA usa el micrófono para que cuentes cómo preparaste tu comida y así estime mejor sus calorías y macros.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1F5637"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7f7bdce3-ac05-4139-a945-101a9eb2a0c9"
      }
    }
  }
}
