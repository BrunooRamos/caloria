{
  "name": "back-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "npm ci --prefix ../shared --no-audit --no-fund",
    "build:shared": "npm run build --prefix ../shared",
    "predev": "npm run build:shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build:shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "pretypecheck": "npm run build:shared",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:shared",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "@caloria/shared": "file:../shared",
    "bcryptjs": "^3.0.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.0",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
